<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?actionBarSize"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ad_bg_color">

        <!-- App Icon Placeholder -->
        <View
            android:id="@+id/ad_app_icon_placeholder"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@color/shimmer_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Headline Placeholder -->
        <View
            android:id="@+id/ad_headline_placeholder"
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@color/shimmer_color"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon_placeholder"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Body Placeholder 1 -->
        <View
            android:id="@+id/ad_body_placeholder1"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:background="@color/shimmer_color"
            app:layout_constraintEnd_toStartOf="@id/ad_call_to_action_placeholder"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon_placeholder"
            app:layout_constraintTop_toBottomOf="@id/ad_headline_placeholder" />

        <!-- Body Placeholder 2 -->
        <View
            android:id="@+id/ad_body_placeholder2"
            android:layout_width="80dp"
            android:layout_height="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:background="@color/shimmer_color"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon_placeholder"
            app:layout_constraintTop_toBottomOf="@id/ad_body_placeholder1" />

        <!-- Call to Action Placeholder -->
        <View
            android:id="@+id/ad_call_to_action_placeholder"
            android:layout_width="100dp"
            android:layout_height="56dp"
            android:background="@drawable/ad_btn_bg"
            android:backgroundTint="@color/shimmer_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
