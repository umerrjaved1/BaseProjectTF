<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="84dp"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="12dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_round_white">

        <View
            android:id="@+id/shimmer_ad_app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_white"
            android:backgroundTint="@color/shimmer_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/shimmer_ll_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/shimmer_ad_app_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center_vertical"
            android:layout_marginStart="14dp">

            <View
                android:layout_width="24dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_circle_primary_light"
                android:backgroundTint="@color/shimmer_color" />

            <View
                android:layout_width="80dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:background="@color/shimmer_color" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:background="@color/shimmer_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/shimmer_ad_app_icon"
            app:layout_constraintTop_toBottomOf="@id/shimmer_ll_headline" />

        <View
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="64dp"
            android:layout_marginTop="4dp"
            android:background="@color/shimmer_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/shimmer_ad_app_icon"
            app:layout_constraintTop_toBottomOf="@+id/shimmer_ll_headline"
            android:translationY="18dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
