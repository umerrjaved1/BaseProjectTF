<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"

        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">


        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@string/icon_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:visibility="gone" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:letterSpacing="-0.02"
            android:paddingHorizontal="8dp"
            android:text="@string/choose_language"
            android:textColor="@color/text_color_primary"
            android:textSize="22sp"
            app:fontFamily="@font/plus_jakarta_sans_bold" />


        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1500"
            app:shimmer_base_alpha="1.0"
            app:shimmer_highlight_alpha="0.7">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ob_btn_gradient"
                android:drawablePadding="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="@string/done"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:fontFamily="@font/plus_jakarta_sans_semi_bold"
                app:icon="@drawable/ic_tick"
                app:iconGravity="textEnd"
                app:iconSize="16dp"
                app:iconTint="@color/white" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvLanguageSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:paddingHorizontal="20dp"
        android:text="@string/language_subtitle"
        android:textColor="@color/text_color_secondary"
        android:textSize="14sp"
        app:fontFamily="@font/plus_jakarta_sans_regular" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_language"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp" />

    <include
        android:id="@+id/includeAd"
        layout="@layout/shimmer_layout_lang_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        />


</LinearLayout>
