<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_window"
        android:padding="12dp">

        <!-- Thumbnail Container -->
        <FrameLayout
            android:id="@+id/cv_thumbnail"
            android:layout_width="100dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- LIVE badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_live_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="@string/live_247"
                android:textColor="@color/white"
                android:textSize="9sp"
                app:fontFamily="@font/plus_jakarta_sans_bold" />
        </FrameLayout>

        <!-- Location Tag -->
        <TextView
            android:id="@+id/tv_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#808B9B"
            android:textSize="12sp"
            app:fontFamily="@font/plus_jakarta_sans_medium"
            app:layout_constraintBottom_toTopOf="@id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/iv_play"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cv_thumbnail"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Greece" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#0B2347"
            android:textSize="14sp"
            app:fontFamily="@font/plus_jakarta_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tv_location"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@id/tv_location"
            app:layout_constraintTop_toBottomOf="@id/tv_location"
            tools:text="POSEIDON ATHENS HOTEL" />

        <!-- Play Button -->
        <ImageView
            android:id="@+id/iv_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_light_blue"
            android:clickable="true"
            android:contentDescription="Play video"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="yes"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0084FF" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Caret pointing down -->
    <ImageView
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginTop="-1dp"
        android:src="@drawable/ic_caret_down" />

</LinearLayout>
