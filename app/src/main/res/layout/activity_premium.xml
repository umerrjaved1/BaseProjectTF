<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header Image -->
        <ImageView
            android:id="@+id/iv_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/premium_header"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Close Button overlaid on header -->
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:src="@drawable/ic_premium_close"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/unlock_premium"
            android:textColor="@color/text_color_dark"
            android:textSize="26sp"
            app:fontFamily="@font/poppins_semi_bold"
            app:layout_constraintTop_toBottomOf="@id/iv_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Features Table Container -->
        <LinearLayout
            android:id="@+id/ll_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Column Headers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:text="@string/free"
                    android:textColor="#8A94A6"
                    android:textSize="12sp"
                    app:fontFamily="@font/poppins_medium" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:text="@string/premium"
                    android:textColor="#8A94A6"
                    android:textSize="12sp"
                    app:fontFamily="@font/poppins_medium" />
            </LinearLayout>

            <!-- Row 1: Free Up Space -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/free_up_space"
                    android:textColor="#18222F"
                    android:textSize="14sp"
                    app:fontFamily="@font/poppins_medium" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_check"
                    android:layout_gravity="center" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_check"
                    android:layout_gravity="center" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke_color"
                android:layout_marginVertical="4dp" />

            <!-- Row 2: Scan & Clean -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_and_clean"
                    android:textColor="#18222F"
                    android:textSize="14sp"
                    app:fontFamily="@font/poppins_medium" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_circle_ring"
                    android:layout_gravity="center" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_check"
                    android:layout_gravity="center" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke_color"
                android:layout_marginVertical="4dp" />

            <!-- Row 3: Uninstall Apps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/uninstall_apps"
                    android:textColor="#18222F"
                    android:textSize="14sp"
                    app:fontFamily="@font/poppins_medium" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_circle_ring"
                    android:layout_gravity="center" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_check"
                    android:layout_gravity="center" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke_color"
                android:layout_marginVertical="4dp" />

            <!-- Row 4: Remove all ads -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/remove_all_ads_premium"
                    android:textColor="#18222F"
                    android:textSize="14sp"
                    app:fontFamily="@font/poppins_medium" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_circle_ring"
                    android:layout_gravity="center" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="0.25"
                    android:src="@drawable/ic_check"
                    android:layout_gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Plans Section Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_plans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/ll_features"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Yearly Plan Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ll_yearly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/accent_color"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_check_yearly"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/yearly"
                            android:textColor="@color/text_color_dark"
                            android:textSize="16sp"
                            app:fontFamily="@font/poppins_semi_bold" />

                        <TextView
                            android:id="@+id/tv_yearly_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Just $0.38/week"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="12sp"
                            app:fontFamily="@font/poppins_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_yearly_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$19.99/year"
                        android:textColor="@color/text_color_dark"
                        android:textSize="16sp"
                        app:fontFamily="@font/poppins_semi_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Badge Overlapping Top-Right of Yearly Card -->
            <TextView
                android:id="@+id/tv_save_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_save"
                android:text="SAVE 80%"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:fontFamily="@font/poppins_semi_bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="16dp"
                android:elevation="4dp"
                app:layout_constraintEnd_toEndOf="@id/ll_yearly"
                app:layout_constraintTop_toTopOf="@id/ll_yearly"
                app:layout_constraintBottom_toTopOf="@id/ll_yearly" />

            <!-- Weekly Plan Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ll_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_color"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/ll_yearly"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_check_weekly"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_circle_ring"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekly"
                            android:textColor="@color/text_color_dark"
                            android:textSize="16sp"
                            app:fontFamily="@font/poppins_semi_bold" />

                        <TextView
                            android:id="@+id/tv_weekly_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3-day free trial"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="12sp"
                            app:fontFamily="@font/poppins_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_weekly_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$2.99/week"
                        android:textColor="@color/text_color_dark"
                        android:textSize="16sp"
                        app:fontFamily="@font/poppins_semi_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Upgrade/Continue Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_upgrade_now"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_premium_btn_gradient"
            app:backgroundTint="@null"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:fontFamily="@font/poppins_semi_bold"
            app:icon="@drawable/ic_crown"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/cl_plans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Disclaimer / Status text (managed in Kotlin) -->
        <TextView
            android:id="@+id/tvFreeTry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:textColor="@color/text_color_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            app:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/btn_upgrade_now"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Auto-renew disclaimer / privacy text -->
        <TextView
            android:id="@+id/tv_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:textColor="@color/text_color_secondary"
            android:textSize="11sp"
            app:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tvFreeTry"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bulleted Footer links -->
        <LinearLayout
            android:id="@+id/ll_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tv_privacy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_restore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/restore"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp"
                app:fontFamily="@font/poppins_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:textColor="@color/text_color_secondary"
                android:textSize="14sp"
                android:paddingHorizontal="4dp" />

            <TextView
                android:id="@+id/tv_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/terms"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp"
                app:fontFamily="@font/poppins_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:textColor="@color/text_color_secondary"
                android:textSize="14sp"
                android:paddingHorizontal="4dp" />

            <TextView
                android:id="@+id/tv_privacy_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/privacy"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp"
                app:fontFamily="@font/poppins_medium" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>