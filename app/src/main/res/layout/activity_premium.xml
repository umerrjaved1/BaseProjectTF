<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:padding="16dp"
            android:src="@drawable/ic_premium_close"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:src="@drawable/ic_premiu_badge" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        app:fontFamily="@font/poppins_semi_bold"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textAllCaps="true"
        android:text="@string/start_like_a_pro"
        android:textColor="@color/text_color_dark"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="2dp"
        app:fontFamily="@font/poppins_regular"
        android:maxLines="1"
        android:text="@string/unlock_all_features"
        android:textColor="@color/grey_color"
        android:textSize="16sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:layout_marginTop="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="visible"
                app:fontFamily="@font/poppins_semi_bold"
                android:text="@string/features"
                android:textColor="@color/text_color_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                app:fontFamily="@font/poppins_semi_bold"
                android:gravity="center"
                android:text="Pro"
                android:textColor="@color/accent_color"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                app:fontFamily="@font/poppins_semi_bold"
                android:gravity="center"
                android:text="Basic"
                android:textColor="@color/grey_color"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="8dp"
                app:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/unlimited_cleaning"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_premium_unlimited_cleaning"
                app:drawableTint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_item_iap"
                app:tint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:tint="@color/accent_color"
                android:src="@drawable/ic_check_item_iap"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="8dp"
                app:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/deep_water_and_dust_removal"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_premium_deep_removal"
                app:drawableTint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_item_iap"
                app:tint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:tint="@color/accent_color"
                android:src="@drawable/ic_check_item_iap" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="8dp"
                app:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/daily_notification"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_premium_daily_notification"
                app:drawableTint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_item_iap"
                app:tint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_cross_item_iap" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="8dp"
                app:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/ad_free_experience"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_premium_ad_free"
                app:drawableTint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="0.5"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_item_iap"
                app:tint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_cross_item_iap" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="8dp"
                app:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/boosted_sound_and_vibration"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_premium_boosted_sound"
                app:drawableTint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_item_iap"
                app:tint="@color/accent_color" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_cross_item_iap" />

        </LinearLayout>
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/ll_weekly"
            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/sku_selected"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:fontFamily="@font/poppins_medium"
                android:text="@string/weekly_subscription"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_weekly_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:text="RS 520.00"
                android:textColor="@color/text_color_primary"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iv_check_weekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_check" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_most_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="48dp"
            android:background="@drawable/gradient_1"
            android:elevation="5dp"

            app:fontFamily="@font/poppins_semi_bold"
            android:letterSpacing="0.01"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/most_popular"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:translationY="-10dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ll_weekly" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_monthly"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/sku_non_selected"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:fontFamily="@font/poppins_semi_bold"
            android:text="@string/monthly_subscription"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_monthly_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:text="RS 999.99"
            android:textColor="@color/text_color_dark"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/iv_check_monthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_non_check" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvFreeTry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        app:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:text="@string/free_trial_disclaimer"
        android:textColor="@color/text_color_primary"
        android:textSize="14sp"
        android:visibility="visible" />



    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_upgrade_now"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="56dp"
        android:text="@string/_3_days_free_trial"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="16sp"
        app:fontFamily="@font/poppins_semi_bold"
        app:backgroundTint="@color/accent_color"
        app:cornerRadius="16dp"
        app:elevation="6dp" />

    <TextView
        android:id="@+id/tv_privacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/cancel_anytime_at_least_24_hours_before_renewal_without_trial"
        android:textColor="@color/text_color_secondary"
        android:textSize="12sp" />

</LinearLayout>