<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen Map Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.6"
        android:src="@drawable/iap_bg"
        android:contentDescription="@null" />

    <!-- Light white overlay for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF" />

    <!-- Hidden ViewPager (kept for Kotlin binding compatibility) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Hidden dots indicator (kept for Kotlin binding compatibility) -->
    <LinearLayout
        android:id="@+id/ll_indicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- Hidden yearly plan card (kept for Kotlin binding compatibility) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ll_yearly"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_check_yearly"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_circle_ring" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_yearly_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_yearly_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Close Button -->
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="40dp"
                android:padding="16dp"
                android:src="@drawable/ic_premium_close"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Hero Diamond / Premium Icon -->
            <ImageView
                android:layout_marginTop="16dp"
                android:id="@+id/iv_hero_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_premium_header"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_close"/>

            <!-- Title: START LIKE A PRO -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/start_like_a_pro_caps"
                android:textColor="@color/text_color_dark"
                android:textSize="26sp"
                android:letterSpacing="0.02"
                app:fontFamily="@font/plus_jakarta_sans_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_hero_icon" />

            <!-- Subtitle: Unlock all features -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/unlock_all_features"
                android:textColor="@color/text_color_secondary"
                android:textSize="15sp"
                app:fontFamily="@font/plus_jakarta_sans_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />

            <!-- Features Comparison Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <!-- Column Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/features"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="13sp"
                            app:fontFamily="@font/plus_jakarta_sans_semi_bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:gravity="center"
                            android:text="@string/free"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="13sp"
                            app:fontFamily="@font/plus_jakarta_sans_semi_bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:gravity="center"
                            android:text="@string/pro"
                            android:textColor="@color/accent_color"
                            android:textSize="14sp"
                            app:fontFamily="@font/plus_jakarta_sans_semi_bold" />
                    </LinearLayout>

                    <!-- Divider under header -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1A000000"
                        android:layout_marginBottom="4dp" />

                    <!-- Row 1: Unlimited Premium -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/unlimited_premium"
                            android:textColor="@color/text_color_primary"
                            android:textSize="14sp"
                            android:drawablePadding="10dp"
                            app:drawableStartCompat="@drawable/ic_unlimited_premium"
                            app:fontFamily="@font/plus_jakarta_sans_medium" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:gravity="center"
                            android:text="@string/txt_symbol_9634"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="0.38"
                            android:src="@drawable/ic_check"
                            app:tint="@color/accent_color" />
                    </LinearLayout>

                    <!-- Row divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#0F000000" />

                    <!-- Row 2: Ads Free Experience -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ads_free_experience"
                            android:textColor="@color/text_color_primary"
                            android:textSize="14sp"
                            android:drawablePadding="10dp"
                            app:drawableStartCompat="@drawable/ic_ads_free"
                            app:fontFamily="@font/plus_jakarta_sans_medium" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:gravity="center"
                            android:text="@string/txt_symbol_9634"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="0.38"
                            android:src="@drawable/ic_check"
                            app:tint="@color/accent_color" />
                    </LinearLayout>

                    <!-- Row divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#0F000000" />

                    <!-- Row 3: VIP Support -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vip_support"
                            android:textColor="@color/text_color_primary"
                            android:textSize="14sp"
                            android:drawablePadding="10dp"
                            app:drawableStartCompat="@drawable/ic_vip_support"
                            app:fontFamily="@font/plus_jakarta_sans_medium" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:gravity="center"
                            android:text="@string/txt_symbol_9634"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="0.38"
                            android:src="@drawable/ic_check"
                            app:tint="@color/accent_color" />
                    </LinearLayout>

                    <!-- Row divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#0F000000" />

                    <!-- Row 4: Live Earth (both Free and Pro) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_earth"
                            android:textColor="@color/text_color_primary"
                            android:textSize="14sp"
                            android:drawablePadding="10dp"
                            app:drawableStartCompat="@drawable/ic_live_earth"
                            app:fontFamily="@font/plus_jakarta_sans_medium" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="0.38"
                            android:src="@drawable/ic_check"
                            app:tint="@color/accent_color" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="0.38"
                            android:src="@drawable/ic_check"
                            app:tint="@color/accent_color" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weekly Plan Card (hidden visually but kept for Kotlin binding) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ll_weekly"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_features">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_check_weekly"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:id="@+id/tv_weekly_sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_weekly_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- tvFreeTry: disclaimer/status (managed in Kotlin) -->
            <TextView
                android:id="@+id/tvFreeTry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp"
                android:visibility="visible"
                app:fontFamily="@font/plus_jakarta_sans_regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/shimmer_btn" />

            <!-- CTA Button (Shimmer wrapped) -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_btn"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                app:shimmer_auto_start="true"
                app:shimmer_duration="1500"
                android:layout_marginBottom="8dp"
                app:shimmer_base_alpha="1.0"
                app:shimmer_highlight_alpha="0.7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tv_privacy">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_upgrade_now"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/try_for_free"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:backgroundTint="@color/accent_color"
                    app:cornerRadius="28dp"
                    app:elevation="4dp"
                    app:fontFamily="@font/plus_jakarta_sans_semi_bold" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Auto-renew disclaimer / privacy text -->
            <TextView
                android:id="@+id/tv_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="10dp"
                android:gravity="center"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp"
                android:text="@string/cancel_anytime_sub"
                android:visibility="visible"
                app:fontFamily="@font/plus_jakarta_sans_regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/ll_footer" />

            <!-- Footer links: Terms · Privacy · Restore -->
            <LinearLayout
                android:id="@+id/ll_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="@string/terms_of_servuce"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="12sp"
                    app:fontFamily="@font/plus_jakarta_sans_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="2dp"
                    android:text="@string/txt_symbol_1902"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_privacy_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="12sp"
                    app:fontFamily="@font/plus_jakarta_sans_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="2dp"
                    android:text="@string/txt_symbol_1902"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_restore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="@string/restore"
                    android:visibility="gone"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="12sp"
                    app:fontFamily="@font/plus_jakarta_sans_medium" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>