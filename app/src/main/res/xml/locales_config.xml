<?xml version="1.0" encoding="utf-8"?>
<!--
  MUST stay in sync with `androidResources.localeFilters` in app/build.gradle.kts and the
  shipped values-*/ directories. This previously listed only 5 of the 10 shipped locales,
  and was not referenced from the manifest at all — so the Android 13+ per-app language
  picker in system settings did nothing.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
    <locale android:name="bn" />
    <locale android:name="es" />
    <locale android:name="fa" />
    <locale android:name="hi" />
    <locale android:name="in" />
    <locale android:name="pt" />
    <locale android:name="ru" />
    <locale android:name="tr" />
</locale-config>
