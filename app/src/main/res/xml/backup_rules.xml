<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules (API 30 and below; API 31+ uses data_extraction_rules.xml).
   https://developer.android.com/guide/topics/data/autobackup

   The entitlement flag must never be restored. `is_premium` lives in the
   "MyPreferences" SharedPreferences file, so a user could back up a device while
   subscribed and restore onto another one to carry premium across — a trivial paywall
   bypass. Entitlement is re-verified against Play on resume, but excluding it here
   means there is no window where a restored flag is trusted at all.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="MyPreferences.xml" />
</full-backup-content>
