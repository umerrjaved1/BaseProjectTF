<!--
  Flag of Spain — civil variant (bandera civil): the red-yellow-red bands without the
  coat of arms. This is an official form of the Spanish flag, legal for civilian use,
  not an approximation.

  Replaces a 245.8 KB / 635-path artwork that carried the full state coat of arms in
  27,085 path coordinates. That crest rendered at roughly 14dp inside a 32dp flag in a
  scrolling RecyclerView, where it was unreadable detail, while every inflation parsed
  and rasterised all 635 paths on the main thread.

  Band bounds are unchanged from the previous artwork (yellow y 3.913 -> 20.087, i.e.
  the original's vertically-cropped 1:2:1 proportions), so this is pixel-identical to
  what shipped before apart from the removed crest. Colours are the originals.

  Geometry matches the other flag_*.xml in this folder: 32x24dp, viewport 32x24,
  2dp rounded clip-path.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="24dp"
    android:autoMirrored="true"
    android:viewportWidth="32"
    android:viewportHeight="24">

    <group>

        <clip-path android:pathData="M2,0L30,0A2,2 0,0 1,32 2L32,22A2,2 0,0 1,30 24L2,24A2,2 0,0 1,0 22L0,2A2,2 0,0 1,2 0z" />

        <!-- Red field -->
        <path
            android:fillColor="#C51918"
            android:pathData="M0,0h32v24h-32z" />

        <!-- Central yellow band -->
        <path
            android:fillColor="#FFB400"
            android:pathData="M0,3.913h32v16.174h-32z" />

    </group>
</vector>
